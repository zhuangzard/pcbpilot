{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "endX": {
   "type": "number"
  },
  "endY": {
   "type": "number"
  },
  "fillColor": {
   "type": [
    "string",
    "null"
   ]
  },
  "fillStyle": {
   "default": null,
   "enum": [
    "NONE",
    "SOLID",
    "GRID",
    "HORIZONTAL_LINE",
    "VERTICAL_LINE",
    "RHOMBIC",
    "LEFT_SLASH_LINE",
    "RIGHT_SLASH_LINE",
    null
   ],
   "type": [
    "string",
    "null"
   ]
  },
  "lineGroup": {
   "pattern": "^[0-9a-f]{16}$",
   "type": "string"
  },
  "startX": {
   "type": "number"
  },
  "startY": {
   "type": "number"
  },
  "strokeColor": {
   "type": [
    "string",
    "null"
   ]
  },
  "strokeStyle": {
   "default": null,
   "enum": [
    "SOLID",
    "SHORT_DASH",
    "DOT",
    "DOT_DASH",
    null
   ],
   "type": [
    "string",
    "null"
   ]
  },
  "strokeWidth": {
   "default": null,
   "type": [
    "number",
    "null"
   ]
  },
  "yAxisDirection": {
   "enum": [
    "up",
    "down"
   ],
   "type": "string"
  }
 },
 "required": [
  "lineGroup",
  "startX",
  "startY",
  "endX",
  "endY",
  "strokeColor",
  "strokeStyle",
  "fillColor",
  "strokeWidth",
  "fillStyle"
 ],
 "type": "object"
}
