{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "differentialName": {
   "type": [
    "string",
    "null"
   ]
  },
  "equalLengthGroupName": {
   "type": [
    "string",
    "null"
   ]
  },
  "isPositiveNet": {
   "type": "boolean"
  },
  "netType": {
   "type": [
    "string",
    "null"
   ]
  },
  "retLine": {
   "type": "boolean"
  },
  "specialColor": {
   "pattern": "^$|^#[0-9A-Fa-f]{6}$",
   "type": [
    "string",
    "null"
   ]
  }
 },
