{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "attrs": {
   "properties": {
    "DeviceName": {},
    "Devices": {},
    "FootprintName": {},
    "Footprints": {},
    "SymbolName": {},
    "Symbols": {},
    "[key: string]": {}
   },
   "type": "object"
  },
  "groupId": {
   "type": "string"
  },
  "isMirror": {
   "type": "boolean"
  },
  "locked": {
   "type": "boolean"
  },
  "partId": {
   "type": "string"
  },
  "rotation": {
   "maximum": 360,
   "minimum": 0,
   "type": "number"
  },
  "x": {
   "type": "number"
  },
  "y": {
   "type": "number"
  },
  "yAxisDirection": {
   "enum": [
    "up",
    "down"
   ],
   "type": "string"
  },
  "zIndex": {
   "type": [
    "number",
    "null"
   ]
  }
 },
 "required": [
  "groupId",
  "locked",
  "zIndex",
  "partId",
  "x",
  "y",
  "rotation",
  "isMirror",
  "attrs"
 ],
 "type": "object"
}
