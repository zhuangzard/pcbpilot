(pcb tiny.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.6")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type signal)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (via "Via[0-3]_600:300_um")
    (rule
      (width 200)
      (clearance 150)
      (clearance 37.5 (type smd_smd))
    )
  )
  (network
    (net VCC
      (pins R1-1 C1-2)
    )
    (class kicad_default "" SIG
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 150)
      )
    )
    (class PP1_W20,Power VCC "/sub/V-"
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 508)
        (clearance 152.4)
      )
    )
    (class PP2_W10,Default GND
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 254)
        (clearance 101.6)
      )
    )
  )
  (wiring
  )
)
