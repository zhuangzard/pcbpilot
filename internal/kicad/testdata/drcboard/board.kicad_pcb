(kicad_pcb
	(version 20250513)
	(generator "pcbpilot-test")
	(layers
		(0 "F.Cu" signal)
		(4 "In1.Cu" signal)
		(6 "In2.Cu" signal)
		(2 "B.Cu" signal)
		(5 "F.SilkS" user "F.Silkscreen")
		(25 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.Cu" (type "copper") (thickness 0.035))
			(copper_finish "ENIG")
		)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "VCC")
	(footprint "Resistor_SMD:R_0603"
		(layer "F.Cu")
		(uuid "fp-r1")
		(at 10 10)
		(property "Reference" "R1" (at 0 0 0) (layer "F.SilkS") (uuid "ref-r1"))
		(fp_line (start 0 0) (end 1 0) (layer "F.SilkS") (uuid "silk-r1"))
		(pad "1" smd rect (at -0.8 0) (size 0.8 0.9) (layers "F.Cu") (net 2 "VCC") (clearance 0.1) (uuid "pad-r1-1"))
		(pad "2" smd rect (at 0.8 0) (size 0.8 0.9) (layers "F.Cu") (net 1 "GND") (uuid "pad-r1-2"))
	)
	(footprint "Capacitor_THT:C_Disc"
		(layer "B.Cu")
		(uuid "fp-c1")
		(at 20 10)
		(property "Reference" "C1" (at 0 0 0) (layer "B.SilkS") (uuid "ref-c1"))
		(clearance 0.2)
		(pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu") (net 2 "VCC") (uuid "pad-c1-1"))
		(pad "" np_thru_hole circle (at 2 0) (size 1 1) (drill 0.6) (layers "*.Cu") (uuid "pad-c1-mh"))
	)
	(footprint "Logo:L1"
		(layer "F.Cu")
		(uuid "fp-logo-a")
		(property "Reference" "REF**" (at 0 0 0) (layer "F.SilkS") (uuid "ref-logo-a"))
		(fp_poly (pts (xy 0 0) (xy 1 0) (xy 1 1)) (layer "F.SilkS") (uuid "poly-logo-a"))
	)
	(footprint "Logo:L1"
		(layer "F.Cu")
		(uuid "fp-logo-b")
		(property "Reference" "REF**" (at 0 0 0) (layer "F.SilkS") (uuid "ref-logo-b"))
	)
	(gr_line (start 0 0) (end 30 0) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts") (uuid "edge-1"))
	(gr_text "rev A" (at 5 5) (layer "F.SilkS") (uuid "txt-1"))
	(segment (start 10 10) (end 20 10) (width 0.15) (layer "F.Cu") (net 2) (uuid "trk-1"))
	(arc (start 20 10) (mid 21 11) (end 22 10) (width 0.25) (layer "B.Cu") (net 1) (uuid "arc-1"))
	(via (at 15 10) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2) (uuid "via-1"))
	(zone (net 1) (net_name "GND") (layer "B.Cu") (uuid "zone-1") (connect_pads (clearance 0.5)))
)
