{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s11">11 {{t "s.measure"}}</h2>
{{if .ProbeSVG}}<figure>{{svg .ProbeSVG}}<figcaption>{{t "probeCaption"}}</figcaption></figure>{{end}}
<h3>{{t "railsTable"}}</h3>
{{if .RailProbes}}<div class="wrap"><table>
<tr><th class="num">{{t "no"}}</th><th>{{t "railNet"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "tolerance"}}</th><th>{{t "simRange"}}</th><th>{{t "current"}}</th><th>{{t "note"}}</th></tr>
{{range .RailProbes}}<tr{{if not .Found}} class="bad"{{end}}><td class="num"><span class="pbadge">{{.N}}</span></td><td class="mono">{{.Name}}</td><td class="mono">{{.Where}}</td><td>{{dash .Expected}}</td><td{{if todo .Tolerance}} class="todo"{{end}}>{{.Tolerance}}</td><td>{{dash .Range}}</td><td>{{dash .Current}}</td><td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "noSim"}}</p>{{end}}
<h3>{{t "signalsTable"}}</h3>
{{if .SigProbes}}<div class="wrap"><table>
<tr><th class="num">{{t "no"}}</th><th>{{t "signal"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "instrument"}}</th><th>{{t "note"}}</th></tr>
{{range .SigProbes}}<tr{{if not .Found}} class="bad"{{end}}><td class="num"><span class="pbadge">{{.N}}</span></td><td>{{.Name}}</td><td class="mono">{{.Where}}</td><td{{if todo .Expected}} class="todo"{{end}}>{{.Expected}}</td><td>{{dash .Instrument}}</td><td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}
{{if .MeasNotes}}<ul>{{range .MeasNotes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}

<h2 id="s12">12 {{t "s.bringup"}}</h2>
{{if .Firmware}}{{if .Firmware.Images}}<h3>{{t "images"}}</h3><div class="wrap"><table><tr><th>{{t "name"}}</th><th>{{t "file"}}</th><th>{{t "tool"}}</th><th>{{t "purpose"}}</th></tr>
{{range .Firmware.Images}}<tr><td>{{.Name}}</td><td class="mono{{if todo .File}} todo{{end}}">{{dash .File}}</td><td>{{dash .Tool}}</td><td>{{.Purpose}}</td></tr>
{{end}}</table></div>{{end}}{{end}}
{{range $i, $s := .Bringup}}<div class="step">
<h3>{{t "step"}} {{add $i 1}}：{{$s.Title}}</h3>
{{if $s.Firmware}}<p><b>{{t "firmware"}}</b>：{{$s.Firmware}}</p>{{end}}
{{if $s.Setup}}<p><b>{{t "setup"}}</b></p><ul>{{range $s.Setup}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
{{if $s.Checks}}<div class="wrap"><table><tr><th>{{t "check"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "see"}}</th><th>{{t "pass"}}</th><th>{{t "fail"}}</th></tr>
{{range $s.Checks}}<tr><td>{{.Item}}</td><td class="mono">{{dash .Probe}}</td><td{{if todo .Expect}} class="todo"{{end}}>{{dash .Expect}}</td><td{{if todo .See}} class="todo"{{end}}>{{dash .See}}</td><td{{if todo .Pass}} class="todo"{{end}}>{{dash .Pass}}</td><td{{if todo .Fail}} class="todo"{{end}}>{{dash .Fail}}</td></tr>
{{end}}</table></div>{{end}}
{{if $s.Note}}<p class="note">{{$s.Note}}</p>{{end}}
</div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s13">13 {{t "s.software"}}</h2>
{{with .Software}}
{{if .Interfaces}}<h3>{{t "interfaces"}}</h3><div class="wrap"><table><tr><th>{{t "name"}}</th><th>{{t "connector"}}</th><th>{{t "settings"}}</th><th>{{t "status"}}</th><th>{{t "note"}}</th></tr>
{{range .Interfaces}}<tr><td>{{.Name}}</td><td>{{dash .Connector}}</td><td{{if todo .Settings}} class="todo"{{end}}>{{dash .Settings}}</td><td{{if todo .Status}} class="todo"{{end}}>{{dash .Status}}</td><td{{if todo .Notes}} class="todo"{{end}}>{{.Notes}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Commands}}<h3>{{t "commands"}}</h3><div class="wrap"><table><tr><th>{{t "key"}}</th><th>{{t "name"}}</th><th>{{t "acceptedIn"}}</th><th>{{t "effect"}}</th><th>{{t "ack"}}</th></tr>
{{range .Commands}}<tr><td class="mono"><b>{{.Key}}</b></td><td>{{.Name}}</td><td>{{dash .AcceptedIn}}</td><td>{{dash .Effect}}</td><td class="mono">{{dash .Ack}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Ack}}<ul>{{range .Ack}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{with .Telemetry}}<h3>{{t "telemetry"}}</h3>
{{if .Period}}<p><b>{{t "period"}}</b>：{{.Period}}</p>{{end}}
{{if .Example}}<p><b>{{t "example"}}</b></p><pre>{{.Example}}</pre>{{end}}
{{if .Fields}}<div class="wrap"><table><tr><th>{{t "field"}}</th><th>{{t "format"}}</th><th>{{t "meaning"}}</th></tr>
{{range .Fields}}<tr><td class="mono"><b>{{.Field}}</b></td><td>{{dash .Format}}</td><td>{{.Meaning}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Notes}}<p class="note">{{.Notes}}</p>{{end}}{{end}}
{{if .Notes}}<ul>{{range .Notes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
{{else}}<p class="note">{{t "none"}}</p>{{end}}
{{if .Firmware}}{{if .Firmware.Notes}}<ul>{{range .Firmware.Notes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}{{end}}
{{if .PinMap}}<h3>{{t "pinMap"}}（{{.PinMapRef}}）</h3><div class="wrap"><table><tr><th>{{t "signal"}}</th><th class="num">{{t "fpgaPin"}}</th><th>{{t "boardNet"}}</th><th>{{t "match"}}</th></tr>
{{range .PinMap}}<tr{{if not .Match}} class="bad"{{end}}><td class="mono">{{.Signal}}</td><td class="num">{{.Pin}}</td><td class="mono">{{dash .Net}}</td><td>{{if .Match}}✓{{else}}✗{{end}}</td></tr>
{{end}}</table></div>{{end}}

<h2 id="s14">14 {{t "s.debug"}}</h2>
{{if .Trouble}}<div class="wrap"><table><tr><th>{{t "symptom"}}</th><th>{{t "cause"}}</th><th>{{t "measureWhat"}}</th></tr>
{{range .Trouble}}<tr><td>{{.Symptom}}</td><td{{if todo .Cause}} class="todo"{{end}}>{{.Cause}}</td><td{{if todo .Check}} class="todo"{{end}}>{{.Check}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s15">15 {{t "s.checks"}}</h2>
{{if .Checks}}<div class="wrap"><table><tr><th>{{t "where"}}</th><th>{{t "doc"}}</th><th>{{t "board"}}</th><th>{{t "note"}}</th></tr>
{{range .Checks}}<tr class="bad"><td class="mono">{{.Where}}</td><td class="mono">{{.Doc}}</td><td class="mono">{{.Board}}</td><td>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p>{{t "noMismatch"}}</p>{{end}}

<h2 id="s16">16 {{t "s.todo"}}</h2>
{{if .TODO}}<ul>{{range .TODO}}<li class="todo">{{.}}</li>{{end}}</ul>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s17">17 {{t "s.sources"}}</h2>
<div class="wrap"><table><tr><th>{{t "kind"}}</th><th>{{t "path"}}</th><th>sha256</th><th class="num">{{t "bytes"}}</th></tr>
{{range .Sources}}<tr><td>{{.Kind}}</td><td class="mono">{{.Path}}</td><td class="mono">{{short .SHA256}}</td><td class="num">{{.Bytes}}</td></tr>
{{end}}</table></div>
{{if .NotesSources}}<p><b>{{t "notesSrc"}}</b></p><ul class="src">{{range .NotesSources}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{if .Version}}<h2 id="s18">18 {{t "s.changes"}}（v{{.Version}}）</h2>
{{if .PrevVersion}}<p>{{sprintf (t "vsPrev") .PrevVersion}}</p>{{if .Changes}}<ul>{{range .Changes}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>{{t "noChange"}}</p>{{end}}{{else}}<p>{{t "firstVersion"}}</p>{{end}}{{end}}
</main>
</body>
</html>
