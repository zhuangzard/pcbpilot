<!doctype html>
<html lang="{{if eq .Lang "en"}}en{{else}}zh-CN{{end}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{.Generator}}">
<title>{{.Title}} {{t "manual"}}</title>
<style>
:root{--fg:#1d1d1f;--muted:#5f6368;--line:#d9d9de;--bg:#ffffff;--head:#f3f4f6;--accent:#c25e00;--todo:#fff4c2;--bad:#fde2e1}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.55 -apple-system,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif}
main{max-width:1060px;margin:0 auto;padding:24px 16px 64px}
h1{font-size:28px;margin:0 0 4px}h2{font-size:21px;margin:36px 0 12px;padding-bottom:6px;border-bottom:2px solid var(--accent)}
h3{font-size:17px;margin:22px 0 8px}h4{font-size:15px;margin:14px 0 6px}
.sub{color:var(--muted);font-size:16px;margin:0 0 16px}
table{border-collapse:collapse;width:100%;margin:8px 0 14px;font-size:13px}
th,td{border:1px solid var(--line);padding:4px 7px;text-align:left;vertical-align:top}
th{background:var(--head);font-weight:600}
td.num,th.num{text-align:right;white-space:nowrap}
.todo{background:var(--todo)}.bad{background:var(--bad)}
.kv{display:grid;grid-template-columns:max-content 1fr;gap:3px 16px;margin:8px 0}
.kv div:nth-child(odd){color:var(--muted)}
figure{margin:10px 0 16px}figure svg{width:100%;height:auto;display:block;background:#fff;border:1px solid var(--line)}
figcaption{color:var(--muted);font-size:12px;margin-top:4px}
.conn{border-top:1px dashed var(--line);margin-top:26px;padding-top:6px}
.conn-head{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.badge{display:inline-block;min-width:24px;height:24px;border-radius:12px;background:var(--accent);color:#fff;text-align:center;font-weight:700;line-height:24px;padding:0 6px}
.pbadge{display:inline-block;min-width:22px;height:22px;border-radius:11px;background:#0a8f3c;color:#fff;text-align:center;font-weight:700;line-height:22px;padding:0 5px}
.sw{display:inline-block;width:12px;height:12px;border-radius:2px;vertical-align:-1px;margin:0 3px 0 10px;border:1px solid #888}
.conn-svg{max-width:760px}.conn-svg svg{width:auto;max-width:100%;margin:0 auto}figure.map svg{max-width:900px;margin:0 auto}
ul.caut li{margin:3px 0}.src{color:var(--muted);font-size:12px}
.note{color:var(--muted)}
code,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px}
pre{background:var(--head);padding:8px 10px;overflow-x:auto;border-radius:4px}
.toc ol{columns:2;margin:4px 0}
.step{border:1px solid var(--line);border-radius:6px;padding:4px 12px 2px;margin:12px 0}
.wrap{overflow-x:auto}
figure.mech svg{width:auto;max-width:100%;height:auto;border:0}
.hlbox{border-left:5px solid var(--accent);background:#fff3e6;padding:8px 12px;margin:10px 0;white-space:pre-line}
@media print{
 @page{size:A4;margin:14mm 12mm}
 body{font-size:11px}main{max-width:none;padding:0}
 h2{break-before:page;margin-top:0}h2.first{break-before:auto}
 .conn{break-before:page;border:0}
 table,figure,.step,tr{break-inside:avoid}
 .toc{break-after:page}
 a{color:inherit;text-decoration:none}
}
@media (max-width:640px){.toc ol{columns:1}.kv{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<header>
<h1>{{.Title}} {{t "manual"}}</h1>
{{if .Subtitle}}<p class="sub">{{.Subtitle}}</p>{{end}}
<div class="kv">
 {{if .Version}}<div>{{t "version"}}</div><div><b>v{{.Version}}</b></div>{{end}}
 {{if .Revision}}<div>{{t "revision"}}</div><div>{{.Revision}}</div>{{end}}
 {{if .BoardSHA}}<div>{{t "boardSha"}}</div><div class="mono">{{.BoardSHA}}</div>{{end}}
 {{if or .Project .Doc}}<div>{{t "projectDoc"}}</div><div>{{.Project}}{{if .Doc}} / {{.Doc}}{{end}}</div>{{end}}
 <div>{{t "boardSize"}}</div><div>{{mm .WidthMM}} × {{mm .HeightMM}} mm</div>
 <div>{{t "layers"}}</div><div>{{.Layers}}</div>
 <div>{{t "parts"}}</div><div>{{.PartCount}}</div>
 <div>{{t "connCount"}}</div><div>{{len .Connectors}}</div>
 <div>{{t "holes"}}</div><div>{{if .Holes}}{{join .Holes "；"}}{{else}}{{t "noHoles"}}{{end}}</div>
 <div>{{t "generated"}}</div><div>{{.Generated}}</div>
 {{if .CapturedAt}}<div>{{t "capturedAt"}}</div><div>{{.CapturedAt}}</div>{{end}}
 <div>{{t "generator"}}</div><div>{{.Generator}}</div>
 <div>{{t "sourceFiles"}}</div><div>{{range $i, $s := .Sources}}{{if $i}}<br>{{end}}<span class="mono">{{$s.Kind}}: {{$s.Path}}</span>{{end}}</div>
</div>
{{if not .HasNotes}}<p class="note">{{t "noNotes"}}</p>{{end}}
{{if not .HasSim}}<p class="note">{{t "noSim"}}</p>{{end}}
</header>

<nav class="toc"><h3>{{t "toc"}}</h3><ol>
<li><a href="#s1">{{t "s.overview"}}</a></li><li><a href="#s2">{{t "s.mech"}}</a></li><li><a href="#s3">{{t "s.board"}}</a></li>
<li><a href="#s4">{{t "s.conns"}}</a></li><li><a href="#s5">{{t "s.power"}}</a></li>
<li><a href="#s6">{{t "s.io"}}</a></li><li><a href="#s7">{{t "s.leds"}}</a></li>
<li><a href="#s8">{{t "s.cautions"}}</a></li><li><a href="#s9">{{t "s.equipment"}}</a></li>
<li><a href="#s10">{{t "s.measure"}}</a></li><li><a href="#s11">{{t "s.bringup"}}</a></li>
<li><a href="#s12">{{t "s.software"}}</a></li><li><a href="#s13">{{t "s.debug"}}</a></li>
<li><a href="#s14">{{t "s.checks"}}</a></li><li><a href="#s15">{{t "s.todo"}}</a></li>
<li><a href="#s16">{{t "s.sources"}}</a></li>{{if .Version}}<li><a href="#s17">{{t "s.changes"}}</a></li>{{end}}
</ol></nav>

<h2 id="s1" class="first">1 {{t "s.overview"}}</h2>
{{if .Overview}}<p>{{.Overview}}</p>{{end}}
{{if .Sequence}}<h3>{{t "sequence"}}</h3><ol>{{range .Sequence}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ol>{{end}}
{{if .Cautions}}<h4>{{t "cautions"}}</h4><ul class="caut">{{range .Cautions}}{{if eq .Source "notes"}}<li{{if todo .Text}} class="todo"{{end}}>{{.Text}}</li>{{end}}{{end}}</ul>{{end}}

<h2 id="s2">2 {{t "s.mech"}}</h2>
{{with .Mech}}
<div class="kv">
 <div>{{t "boardSize"}}</div><div><b>{{mm .WidthMM}} × {{mm .HeightMM}} mm</b></div>
 <div>{{t "corners"}}</div><div>{{.Corners}}</div>
 <div>{{t "origin"}}</div><div>{{t "originText"}}</div>
 <div>{{t "thickness"}}</div><div>{{dash .Thickness}}</div>
 <div>{{t "layers"}}</div><div>{{.Layers}}</div>
 {{if .Pitch}}<div>{{t "pitch"}}</div><div>{{.Pitch}}</div>{{end}}
 <div>{{t "scale"}}</div><div>{{.Scale}}</div>
 <div>{{t "download"}}</div><div><a download="mechanical.svg" href="{{dataurl .SVGDataURI}}">{{t "dlSVG"}}</a> · <a download="mechanical.csv" href="{{dataurl .CSVDataURI}}">{{t "dlCSV"}}</a></div>
</div>
<figure class="mech">{{svg .SVG}}</figure>
<h3>{{t "holeTable"}}</h3>
<div class="wrap"><table><tr><th>{{t "ref"}}</th><th>{{t "function"}}</th><th class="num">X mm</th><th class="num">Y mm</th><th class="num">{{t "drill"}}</th><th class="num">{{t "ring"}}</th><th>{{t "plated"}}</th><th>{{t "net"}}</th><th class="num">{{t "keepOut"}}</th><th>{{t "screw"}}</th></tr>
{{range .Holes}}<tr><td>{{.Ref}}</td><td>{{.Function}}</td><td class="num">{{mm .X}}</td><td class="num">{{mm .Y}}</td><td class="num">{{mm .Drill}}</td><td class="num">{{if .Ring}}{{mm .Ring}}{{else}}—{{end}}</td><td>{{.Plated}}</td><td>{{.Net}}</td><td class="num">{{if .KeepOut}}{{mm .KeepOut}}{{else}}—{{end}}</td><td>{{.Screw}}</td></tr>
{{end}}</table></div>
<h3>{{t "viaTable"}}</h3>
<div class="wrap"><table><tr><th>{{t "viaType"}}</th><th class="num">{{t "count"}}</th></tr>
{{range .Vias}}<tr><td>Ø{{mm .DrillMM}} / Ø{{mm .PadMM}}</td><td class="num">{{.Count}}</td></tr>{{end}}
<tr><th>{{t "minTrack"}}</th><td class="num">{{mm .MinTrackMil}} mil（{{mmil .MinTrackMil}} mm）</td></tr>
<tr><th>{{t "minSpace"}}</th><td class="num">{{mm .MinSpaceMil}} mil（{{mmil .MinSpaceMil}} mm）</td></tr>
</table></div>
<h3>{{t "connPos"}}</h3>
<div class="wrap"><table><tr><th>{{t "ref"}}</th><th>{{t "pin1Pos"}}</th><th>{{t "bodyPos"}}</th><th class="num">{{t "rotation"}}</th><th>{{t "edge"}}</th><th class="num">{{t "edgeDist"}}</th><th class="num">{{t "pin1Dist"}}</th><th class="num">{{t "overhang"}}</th><th>{{t "matingDir"}}</th></tr>
{{range .ConnPos}}<tr><td>{{.Ref}}</td><td>({{mm .Pin1X}}, {{mm .Pin1Y}})</td><td>({{mm .BodyX}}, {{mm .BodyY}})</td><td class="num">{{mm .Rotation}}°</td><td>{{.Edge}}</td><td class="num">{{mm .EdgeDist}}</td><td class="num">{{mm .Pin1Dist}}</td><td class="num">{{if .Overhang}}{{mm .Overhang}}{{else}}—{{end}}</td><td>{{dash .Mating}}</td></tr>
{{end}}</table></div>
<h3>{{t "heights"}}</h3>
{{if .Heights}}<div class="wrap"><table><tr><th>{{t "ref"}}</th><th>{{t "side"}}</th><th class="num">{{t "heightMm"}}</th><th>{{t "source"}}</th></tr>
{{range .Heights}}<tr><td>{{.Ref}}</td><td>{{if eq .Side "bottom"}}{{t "edgeB"}}{{else}}top{{end}}</td><td class="num">{{mm .HeightMm}}</td><td>{{.Source}}</td></tr>{{end}}
</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}
{{if .Notes}}<ul>{{range .Notes}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{end}}

<h2 id="s3">3 {{t "s.board"}}</h2>
<figure class="map">{{svg .BoardSVG}}<figcaption>{{t "boardCaption"}}</figcaption></figure>
<div class="wrap"><table>
<tr><th class="num">{{t "no"}}</th><th>{{t "ref"}}</th><th>{{t "role"}}</th><th>{{t "name"}}</th><th>{{t "device"}}</th><th class="num">{{t "pinCount"}}</th><th>{{t "position"}}</th><th>{{t "purpose"}}</th></tr>
{{range .Connectors}}<tr><td class="num"><span class="badge">{{.Index}}</span></td><td><a href="#c-{{.Ref}}">{{.Ref}}</a></td><td><span class="sw" style="margin-left:0;background:{{.Color}}"></span>{{.Role}}</td><td{{if not .Name}} class="todo"{{end}}>{{if .Name}}{{.Name}}{{else}}{{t "todoMark"}}{{end}}</td><td>{{.Device}}</td><td class="num">{{.PadCount}}</td><td>({{mm .XMM}}, {{mm .YMM}})</td><td{{if todo .Purpose}} class="todo"{{end}}>{{dash .Purpose}}</td></tr>
{{end}}</table></div>

<h2 id="s4">4 {{t "s.conns"}}</h2>
<p class="note">{{t "legend"}}：<span class="sw" style="background:#d62728"></span>{{t "role.power"}}<span class="sw" style="background:#222"></span>{{t "role.ground"}}<span class="sw" style="background:#1f5fbf"></span>{{t "role.signal"}}<span class="sw" style="background:#a8a8a8"></span>{{t "role.nc"}}</p>
{{range .Connectors}}
<section class="conn" id="c-{{.Ref}}">
<div class="conn-head"><span class="badge">{{.Index}}</span><h3>{{.Ref}} {{.Role}} {{.Name}}</h3><span class="note">{{if .Subtitle}}{{.Subtitle}} · {{end}}{{.Device}} · {{.PadCount}} {{t "pinsWord"}}</span></div>
<div class="kv">
 <div>{{t "purpose"}}</div><div{{if todo .Purpose}} class="todo"{{end}}>{{dash .Purpose}}</div>
 {{if .ConnectsTo}}<div>{{t "connectsTo"}}</div><div{{if todo .ConnectsTo}} class="todo"{{end}}>{{.ConnectsTo}}</div>{{end}}
 {{if .SystemRole}}<div>{{t "systemRole"}}</div><div{{if todo .SystemRole}} class="todo"{{end}}>{{.SystemRole}}</div>{{end}}
 <div>{{t "mating"}}</div><div{{if todo .Mating}} class="todo"{{end}}>{{dash .Mating}}</div>
 {{if .Part}}<div>{{t "device"}}</div><div>{{.Part}}</div>{{end}}
 <div>{{t "position"}}</div><div>({{mm .XMM}}, {{mm .YMM}})</div>
</div>
{{if .Highlight}}<div class="hlbox">{{.Highlight}}</div>{{end}}
{{if .Usage}}<h4>{{t "usage"}}</h4><ol>{{range .Usage}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ol>{{end}}
<figure class="conn-svg">{{svg .SVG}}<figcaption>{{t "connCaption"}}</figcaption></figure>
<div class="wrap"><table>
<tr><th class="num">{{t "pin"}}</th><th>{{t "net"}}</th><th>{{t "role"}}</th><th>{{t "voltage"}}</th><th>{{t "maxCurrent"}}</th><th>{{t "direction"}}</th>{{if .HasDocs}}<th>{{t "docNet"}}</th>{{end}}<th>{{t "note"}}</th></tr>
{{$docs := .HasDocs}}{{range .Pins}}<tr{{if .Mismatch}} class="bad"{{end}}><td class="num">{{.Pin}}</td><td class="mono">{{if .Net}}{{.Net}}{{else}}NC{{end}}</td><td style="white-space:nowrap"><span class="sw" style="margin-left:0;background:{{if eq .Role "power"}}#d62728{{else if eq .Role "ground"}}#222{{else if eq .Role "nc"}}#a8a8a8{{else}}#1f5fbf{{end}}"></span>{{role .Role}}</td><td>{{dash .Voltage}}</td><td>{{dash .MaxCurrent}}</td><td>{{dash .Direction}}</td>{{if $docs}}<td class="mono">{{dash .DocNet}}</td>{{end}}<td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>
{{if .Cautions}}<h4>{{t "cautions"}}</h4><ul class="caut">{{range .Cautions}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
</section>
{{end}}

<h2 id="s5">5 {{t "s.power"}}</h2>
<h3>{{t "input"}}</h3>
<div class="wrap"><table>
<tr><th>{{t "inputConn"}}</th><td>{{dash .Power.InputRef}}{{if .Power.InputPins}}（{{.Power.InputPins}}）{{end}}</td></tr>
<tr><th>{{t "inputVoltage"}}</th><td>{{dash .Power.Voltage}}</td></tr>
<tr><th>{{t "range"}}</th><td{{if todo .Power.Input.VoltageRange}} class="todo"{{end}}>{{dash .Power.Input.VoltageRange}}</td></tr>
{{if .Power.Input.Plug}}<tr><th>{{t "plug"}}</th><td>{{.Power.Input.Plug}}</td></tr>{{end}}
<tr><th>{{t "polarity"}}</th><td{{if todo .Power.Input.Polarity}} class="todo"{{end}}>{{dash .Power.Input.Polarity}}</td></tr>
<tr><th>{{t "protection"}}</th><td{{if todo .Power.Input.Protection}} class="todo"{{end}}>{{dash .Power.Input.Protection}}</td></tr>
{{if .Power.Input.IdleCurrent}}<tr><th>{{t "idleCurrent"}}</th><td{{if todo .Power.Input.IdleCurrent}} class="todo"{{end}}>{{.Power.Input.IdleCurrent}}</td></tr>{{end}}
<tr><th>{{t "curTyp"}}</th><td>{{dash .Power.Typ}}</td></tr>
<tr><th>{{t "curPeak"}}</th><td>{{dash .Power.Peak}}</td></tr>
<tr><th>{{t "curWorst"}}</th><td>{{dash .Power.Worst}}</td></tr>
<tr><th>{{t "recSupply"}}</th><td>{{dash .Power.Recommend}}{{if .Power.Input.RecommendedSupply}}<br><b>{{.Power.Input.RecommendedSupply}}</b>{{end}}</td></tr>
</table></div>
{{if .Power.Notes}}<ul>{{range .Power.Notes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
<h3>{{t "rails"}}</h3>
{{if .Power.Rails}}<div class="wrap"><table>
<tr><th>{{t "railNet"}}</th>{{range .Power.Scenarios}}<th>{{.}}（V / A）</th>{{end}}</tr>
{{range .Power.Rails}}<tr><td class="mono">{{.Net}}</td>{{range .Values}}<td class="num">{{.}}</td>{{end}}</tr>
{{end}}</table></div>{{else}}<p class="note">{{t "noSim"}}</p>{{end}}

<h2 id="s6">6 {{t "s.io"}}</h2>
{{if .IO}}<div class="wrap"><table>
<tr><th>{{t "connector"}}</th><th class="num">{{t "pin"}}</th><th>{{t "signal"}}</th><th>{{t "net"}}</th><th>{{t "direction"}}</th><th>{{t "level"}}</th><th>{{t "maxCurrent"}}</th><th>{{t "note"}}</th></tr>
{{range .IO}}<tr><td>{{.Connector}}</td><td class="num">{{.Pin}}</td><td>{{.Signal}}</td><td class="mono">{{dash .Net}}</td><td>{{dash .Direction}}</td><td{{if todo .Level}} class="todo"{{end}}>{{dash .Level}}</td><td{{if todo .MaxCurrent}} class="todo"{{end}}>{{dash .MaxCurrent}}</td><td{{if todo .Notes}} class="todo"{{end}}>{{.Notes}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s7">7 {{t "s.leds"}}</h2>
{{if .LEDSVG}}<figure>{{svg .LEDSVG}}<figcaption>{{t "ledCaption"}}</figcaption></figure>{{end}}
{{if .LEDs}}<div class="wrap"><table>
<tr><th>{{t "ref"}}</th><th>{{t "name"}}</th><th>{{t "colorCol"}}</th><th>{{t "ledNet"}}</th>{{range .Firmwares}}<th>{{t "firmware"}} {{.}}</th>{{end}}{{if not .Firmwares}}<th>{{t "note"}}</th>{{end}}</tr>
{{$fw := .Firmwares}}{{range .LEDs}}<tr{{if .Mismatch}} class="bad"{{end}}><td>{{.Ref}}</td><td>{{dash .Name}}</td><td><span class="sw" style="margin-left:0;background:{{ledFill .Color}}"></span>{{dash .Color}}</td><td class="mono">{{dash .Net}}</td>{{if .Hardware}}<td colspan="{{if $fw}}{{len $fw}}{{else}}1{{end}}"><b>{{t "hwLED"}}</b>：{{.Hardware}}</td>{{else}}{{range .Modes}}<td{{if todo .}} class="todo"{{end}}>{{.}}</td>{{end}}{{if not $fw}}<td>—</td>{{end}}{{end}}</tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s8">8 {{t "s.cautions"}}</h2>
{{if .Cautions}}<h3>{{t "notesCautions"}}</h3><ul class="caut">{{range .Cautions}}{{if eq .Source "notes"}}<li{{if todo .Text}} class="todo"{{end}}>{{.Text}}</li>{{end}}{{end}}</ul>{{end}}
{{if .ConnCaut}}<h3>{{t "connCautionSum"}}</h3><ul class="caut">{{range .ConnCaut}}<li{{if todo .Text}} class="todo"{{end}}>{{.Text}}</li>{{end}}</ul>{{end}}
<h3>{{t "autoCautions"}}</h3><ul class="caut">{{range .Cautions}}{{if eq .Source "auto"}}<li>{{.Text}}</li>{{end}}{{end}}</ul>
<h3>{{t "jumpers"}}</h3>
{{if .Jumpers}}<div class="wrap"><table><tr><th>{{t "ref"}}</th><th>{{t "name"}}</th><th>{{t "default"}}</th><th>{{t "settings"}}</th><th>{{t "note"}}</th></tr>
{{range .Jumpers}}<tr><td>{{.Ref}}</td><td>{{.Name}}</td><td{{if todo .Default}} class="todo"{{end}}>{{dash .Default}}</td><td>{{range $i, $s := .Settings}}{{if $i}}<br>{{end}}{{$s}}{{end}}</td><td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s9">9 {{t "s.equipment"}}</h2>
{{if .Equipment}}<div class="wrap"><table><tr><th>{{t "item"}}</th><th>{{t "spec"}}</th><th>{{t "purpose"}}</th></tr>
{{range .Equipment}}<tr><td>{{.Item}}</td><td{{if todo .Spec}} class="todo"{{end}}>{{.Spec}}</td><td>{{.Purpose}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s10">10 {{t "s.measure"}}</h2>
{{if .ProbeSVG}}<figure>{{svg .ProbeSVG}}<figcaption>{{t "probeCaption"}}</figcaption></figure>{{end}}
<h3>{{t "railsTable"}}</h3>
{{if .RailProbes}}<div class="wrap"><table>
<tr><th class="num">{{t "no"}}</th><th>{{t "railNet"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "tolerance"}}</th><th>{{t "simRange"}}</th><th>{{t "current"}}</th><th>{{t "note"}}</th></tr>
{{range .RailProbes}}<tr{{if not .Found}} class="bad"{{end}}><td class="num"><span class="pbadge">{{.N}}</span></td><td class="mono">{{.Name}}</td><td class="mono">{{.Where}}</td><td>{{dash .Expected}}</td><td{{if todo .Tolerance}} class="todo"{{end}}>{{.Tolerance}}</td><td>{{dash .Range}}</td><td>{{dash .Current}}</td><td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "noSim"}}</p>{{end}}
<h3>{{t "signalsTable"}}</h3>
{{if .SigProbes}}<div class="wrap"><table>
<tr><th class="num">{{t "no"}}</th><th>{{t "signal"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "instrument"}}</th><th>{{t "note"}}</th></tr>
{{range .SigProbes}}<tr{{if not .Found}} class="bad"{{end}}><td class="num"><span class="pbadge">{{.N}}</span></td><td>{{.Name}}</td><td class="mono">{{.Where}}</td><td{{if todo .Expected}} class="todo"{{end}}>{{.Expected}}</td><td>{{dash .Instrument}}</td><td{{if todo .Note}} class="todo"{{end}}>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}
{{if .MeasNotes}}<ul>{{range .MeasNotes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}

<h2 id="s11">11 {{t "s.bringup"}}</h2>
{{if .Firmware}}{{if .Firmware.Images}}<h3>{{t "images"}}</h3><div class="wrap"><table><tr><th>{{t "name"}}</th><th>{{t "file"}}</th><th>{{t "tool"}}</th><th>{{t "purpose"}}</th></tr>
{{range .Firmware.Images}}<tr><td>{{.Name}}</td><td class="mono{{if todo .File}} todo{{end}}">{{dash .File}}</td><td>{{dash .Tool}}</td><td>{{.Purpose}}</td></tr>
{{end}}</table></div>{{end}}{{end}}
{{range $i, $s := .Bringup}}<div class="step">
<h3>{{t "step"}} {{add $i 1}}：{{$s.Title}}</h3>
{{if $s.Firmware}}<p><b>{{t "firmware"}}</b>：{{$s.Firmware}}</p>{{end}}
{{if $s.Setup}}<p><b>{{t "setup"}}</b></p><ul>{{range $s.Setup}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
{{if $s.Checks}}<div class="wrap"><table><tr><th>{{t "check"}}</th><th>{{t "probe"}}</th><th>{{t "expected"}}</th><th>{{t "see"}}</th><th>{{t "pass"}}</th><th>{{t "fail"}}</th></tr>
{{range $s.Checks}}<tr><td>{{.Item}}</td><td class="mono">{{dash .Probe}}</td><td{{if todo .Expect}} class="todo"{{end}}>{{dash .Expect}}</td><td{{if todo .See}} class="todo"{{end}}>{{dash .See}}</td><td{{if todo .Pass}} class="todo"{{end}}>{{dash .Pass}}</td><td{{if todo .Fail}} class="todo"{{end}}>{{dash .Fail}}</td></tr>
{{end}}</table></div>{{end}}
{{if $s.Note}}<p class="note">{{$s.Note}}</p>{{end}}
</div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s12">12 {{t "s.software"}}</h2>
{{with .Software}}
{{if .Interfaces}}<h3>{{t "interfaces"}}</h3><div class="wrap"><table><tr><th>{{t "name"}}</th><th>{{t "connector"}}</th><th>{{t "settings"}}</th><th>{{t "status"}}</th><th>{{t "note"}}</th></tr>
{{range .Interfaces}}<tr><td>{{.Name}}</td><td>{{dash .Connector}}</td><td{{if todo .Settings}} class="todo"{{end}}>{{dash .Settings}}</td><td{{if todo .Status}} class="todo"{{end}}>{{dash .Status}}</td><td{{if todo .Notes}} class="todo"{{end}}>{{.Notes}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Commands}}<h3>{{t "commands"}}</h3><div class="wrap"><table><tr><th>{{t "key"}}</th><th>{{t "name"}}</th><th>{{t "acceptedIn"}}</th><th>{{t "effect"}}</th><th>{{t "ack"}}</th></tr>
{{range .Commands}}<tr><td class="mono"><b>{{.Key}}</b></td><td>{{.Name}}</td><td>{{dash .AcceptedIn}}</td><td>{{dash .Effect}}</td><td class="mono">{{dash .Ack}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Ack}}<ul>{{range .Ack}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{with .Telemetry}}<h3>{{t "telemetry"}}</h3>
{{if .Period}}<p><b>{{t "period"}}</b>：{{.Period}}</p>{{end}}
{{if .Example}}<p><b>{{t "example"}}</b></p><pre>{{.Example}}</pre>{{end}}
{{if .Fields}}<div class="wrap"><table><tr><th>{{t "field"}}</th><th>{{t "format"}}</th><th>{{t "meaning"}}</th></tr>
{{range .Fields}}<tr><td class="mono"><b>{{.Field}}</b></td><td>{{dash .Format}}</td><td>{{.Meaning}}</td></tr>
{{end}}</table></div>{{end}}
{{if .Notes}}<p class="note">{{.Notes}}</p>{{end}}{{end}}
{{if .Notes}}<ul>{{range .Notes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}
{{else}}<p class="note">{{t "none"}}</p>{{end}}
{{if .Firmware}}{{if .Firmware.Notes}}<ul>{{range .Firmware.Notes}}<li{{if todo .}} class="todo"{{end}}>{{.}}</li>{{end}}</ul>{{end}}{{end}}
{{if .PinMap}}<h3>{{t "pinMap"}}（{{.PinMapRef}}）</h3><div class="wrap"><table><tr><th>{{t "signal"}}</th><th class="num">{{t "fpgaPin"}}</th><th>{{t "boardNet"}}</th><th>{{t "match"}}</th></tr>
{{range .PinMap}}<tr{{if not .Match}} class="bad"{{end}}><td class="mono">{{.Signal}}</td><td class="num">{{.Pin}}</td><td class="mono">{{dash .Net}}</td><td>{{if .Match}}✓{{else}}✗{{end}}</td></tr>
{{end}}</table></div>{{end}}

<h2 id="s13">13 {{t "s.debug"}}</h2>
{{if .Trouble}}<div class="wrap"><table><tr><th>{{t "symptom"}}</th><th>{{t "cause"}}</th><th>{{t "measureWhat"}}</th></tr>
{{range .Trouble}}<tr><td>{{.Symptom}}</td><td{{if todo .Cause}} class="todo"{{end}}>{{.Cause}}</td><td{{if todo .Check}} class="todo"{{end}}>{{.Check}}</td></tr>
{{end}}</table></div>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s14">14 {{t "s.checks"}}</h2>
{{if .Checks}}<div class="wrap"><table><tr><th>{{t "where"}}</th><th>{{t "doc"}}</th><th>{{t "board"}}</th><th>{{t "note"}}</th></tr>
{{range .Checks}}<tr class="bad"><td class="mono">{{.Where}}</td><td class="mono">{{.Doc}}</td><td class="mono">{{.Board}}</td><td>{{.Note}}</td></tr>
{{end}}</table></div>{{else}}<p>{{t "noMismatch"}}</p>{{end}}

<h2 id="s15">15 {{t "s.todo"}}</h2>
{{if .TODO}}<ul>{{range .TODO}}<li class="todo">{{.}}</li>{{end}}</ul>{{else}}<p class="note">{{t "none"}}</p>{{end}}

<h2 id="s16">16 {{t "s.sources"}}</h2>
<div class="wrap"><table><tr><th>{{t "kind"}}</th><th>{{t "path"}}</th><th>sha256</th><th class="num">{{t "bytes"}}</th></tr>
{{range .Sources}}<tr><td>{{.Kind}}</td><td class="mono">{{.Path}}</td><td class="mono">{{short .SHA256}}</td><td class="num">{{.Bytes}}</td></tr>
{{end}}</table></div>
{{if .NotesSources}}<p><b>{{t "notesSrc"}}</b></p><ul class="src">{{range .NotesSources}}<li>{{.}}</li>{{end}}</ul>{{end}}
{{if .Version}}<h2 id="s17">17 {{t "s.changes"}}（v{{.Version}}）</h2>
{{if .PrevVersion}}<p>{{sprintf (t "vsPrev") .PrevVersion}}</p>{{if .Changes}}<ul>{{range .Changes}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>{{t "noChange"}}</p>{{end}}{{else}}<p>{{t "firstVersion"}}</p>{{end}}{{end}}
</main>
</body>
</html>
