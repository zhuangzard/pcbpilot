! pcbpilot sim post-layout — Elmer FEM cross-check of the board thermal model
! units: m, W, °C (steady linear heat equation; Density = 1 so Heat Source is W/m³)
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
  Results Directory "results"
End

Simulation
  Max Output Level = 3
  Coordinate System = Cartesian 3D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals = 1
End

Constants
  Stefan Boltzmann = 5.670e-08
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

